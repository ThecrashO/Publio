# PostPilot Environment Variables

# Supabase Project URL (From Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public Key (Safe for browser frontend)
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Secret Key (FOR BACKEND CLI / SECRETS ONLY - NEVER EXPOSE IN FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
